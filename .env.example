# ---------------------------------------------------------------------------
# deck_controller
# ---------------------------------------------------------------------------

# Shared secret. Every /api/* call and both websockets require it.
# The tablet gets it once via ?token=... and remembers it in localStorage.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# Leave EMPTY to disable auth entirely (LAN-only, not recommended).
DECK_TOKEN=

DECK_HTTP_PORT=8095

# ---------------------------------------------------------------------------
# OBS (runs on the streaming PC, not the Pi)
# ---------------------------------------------------------------------------
# Enable the server first: OBS -> Tools -> WebSocket Server Settings -> Enable.
# The password is the one shown in that dialog.
#
# OBS_HOST resolves over Tailscale. If MagicDNS misbehaves inside Docker,
# use the Tailscale IP instead -- cachyowo is 100.69.244.83.
OBS_HOST=cachyowo
OBS_PORT=4455
OBS_PASSWORD=

# ---------------------------------------------------------------------------
# RabbitMQ (the existing twitch-broadcaster broker)
# ---------------------------------------------------------------------------
RABBITMQ_URL=amqp://overlay:strongpassword@rabbitmq:5672/
TWITCH_EXCHANGE=twitch_events
DABI_EXCHANGE=dabi_events

# ---------------------------------------------------------------------------
# Paths (inside the container)
# ---------------------------------------------------------------------------
DECK_CONFIG=/config/deck.yaml
MUSIC_LIBRARY=/songs
